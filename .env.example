# =======================================================================
# Template de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas configurações locais.
# NUNCA submeta o arquivo .env com credenciais reais ao repositório!
# =======================================================================

# Fonte de Dados / Banco Relacional (se aplicável ao pipeline ETL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=industria_db
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura

# Power BI Service / Gateway / API
POWERBI_WORKSPACE_ID=seu_workspace_id_aqui
POWERBI_REPORT_ID=seu_report_id_aqui
POWERBI_CLIENT_ID=seu_client_id_azure_ad
POWERBI_CLIENT_SECRET=seu_client_secret_azure_ad
POWERBI_TENANT_ID=seu_tenant_id_azure_ad

# Orange Data Mining / Python Pipeline
DATASET_PATH=./dados/base_producao.xlsx
MODEL_OUTPUT_PATH=./modelos/modelo_preditivo_refugo.pk5
LOG_LEVEL=INFO
