# =======================================================================
# Git Ignore - Indústria & Produção (Power BI, Excel, ML & Data Analytics)
# =======================================================================

# Arquivos Temporários do Microsoft Office / Excel
~$*
~$*.xlsx
~$*.xlsm
~$*.xls
~$*.csv.tmp

# Arquivos Temporários e Backups do Power BI
*.pbix.tmp
*.pbit.tmp
autoRecover/
*.abf

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.production
.env.staging
*.pem
*.key
*.pfx
*.cert
credentials.json
client_secret*.json

# Logs e Relatórios de Erro
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Orange Data Mining Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ipynb_checkpoints/
*.ows.autosave

# Modelos binários pesados de ML (se gerados separadamente)
# Descomente se salvar modelos .pkl ou .joblib acima de 100MB
# *.pkl
# *.joblib
# *.onnx

# Arquivos do Sistema Operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# IDE & Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.fleet/
